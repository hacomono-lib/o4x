# Multi-stage build: Generate DDL from schema/schema.go and include in PostgreSQL image
# This ensures schema/schema.go is the single source of truth for DDL

FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# Generate schema for main database (o4x)
RUN go run cmd/o4x-schema/main.go --with-consumer > /schema.sql

# Generate init script for test database
# This creates the test database and applies the same schema
RUN echo "-- Create test database for integration tests" > /init-test-db.sql && \
    echo "COMMIT;" >> /init-test-db.sql && \
    echo "CREATE DATABASE o4x_test;" >> /init-test-db.sql && \
    echo "\\connect o4x_test" >> /init-test-db.sql && \
    echo "" >> /init-test-db.sql && \
    go run cmd/o4x-schema/main.go --with-consumer >> /init-test-db.sql

FROM postgres:17-alpine
COPY --from=builder /schema.sql /docker-entrypoint-initdb.d/01_schema.sql
COPY --from=builder /init-test-db.sql /docker-entrypoint-initdb.d/03_init_test_db.sql
COPY examples/local/seed.sql /docker-entrypoint-initdb.d/02_seed.sql
RUN chmod 644 /docker-entrypoint-initdb.d/*
