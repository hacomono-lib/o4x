FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build consumer
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/consumer ./examples/app/cmd/consumer

FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /app/consumer .

EXPOSE 8081

CMD ["./consumer", "--workers", "2"]
