FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build dispatcher
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/dispatcher ./examples/app/cmd/dispatcher

FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /app/dispatcher .

EXPOSE 8080

CMD ["./dispatcher", "--multi-queue", "--workers", "2"]
