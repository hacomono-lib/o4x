FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build both dispatcher and dispatcher-bench
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/dispatcher ./examples/app/cmd/dispatcher
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/dispatcher-bench ./examples/app/cmd/dispatcher-bench

FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /app/dispatcher ./bin/dispatcher
COPY --from=builder /app/dispatcher-bench ./bin/dispatcher-bench

EXPOSE 8080

CMD ["./bin/dispatcher", "--multi-queue", "--workers", "2"]
